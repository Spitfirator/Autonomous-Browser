# Copy this file to gpu.local.env and fill in the values for your booked host.
# gpu.local.env is ignored by Git. Do not put passwords or private keys here.

GPU_HOST=${GPU_HOST:-user@gpu-host.example}
GPU_JUMP_HOST=${GPU_JUMP_HOST:-user@jump-host.example}
SOCKET=${SOCKET:-/tmp/agentdojo-gpu.sock}

# Optional when Ollama is installed outside the setup script's default:
# REMOTE_OLLAMA_BIN=/remote/path/to/ollama

# Each model/profile combination gets a separate RUN_TAG automatically.
# Override these together when changing the experiment:
# MODEL=qwen3.5-agentdojo:9b
# PROFILE=thinking
# RUN_TAG=qwen35-9b-thinking
