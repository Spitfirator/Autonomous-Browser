# Copy to wasp.local.env. The copy is ignored by Git.
#
# Browser and benchmark services are reached through SSH forwards. These
# defaults intentionally contain no UCL usernames, hostnames, or credentials.
export GITLAB="http://127.0.0.1:18023"
export REDDIT="http://127.0.0.1:19999"
export WASP_OLLAMA_HOST="http://127.0.0.1:11435"
export WASP_MODEL="qwen3.5-agentdojo:9b"
export WASP_RUN_TAG="wasp-qwen35-9b-browser32k-30step-v1"
export WASP_MAX_STEPS="30"
# Restore pristine GitLab/Reddit clones before each new 21-task cell. This
# clears Postmill's in-memory posting cooldown without touching checkpoints.
export WASP_RESET_BETWEEN_CELLS="1"

# Existing SSH control-master details (local-only).
export WASP_SSH_SOCKET="/tmp/ucl-gpu-codex.sock"
export WASP_REMOTE_HOST=""
export WASP_REMOTE_ROOT="/scratch0/$USER/wasp"
export WASP_CONTAINER_RUNTIME="auto"

# Port mapping. The public GitLab URL must match the URL visible to the local
# benchmark browser because GitLab emits absolute links.
export WASP_GITLAB_LOCAL_PORT="18023"
export WASP_GITLAB_REMOTE_PORT="8023"
export WASP_REDDIT_LOCAL_PORT="19999"
export WASP_REDDIT_REMOTE_PORT="9999"
export WASP_OLLAMA_LOCAL_PORT="11435"
export WASP_OLLAMA_REMOTE_PORT="11434"

# Names of images after the official WebArena tar archives have been loaded.
export WASP_GITLAB_IMAGE="gitlab-populated-final-port8023"
export WASP_REDDIT_IMAGE="postmill-populated-exposed-withimg"

# The remote script downloads official archives when they are missing. Docker
# loads them as images. Singularity builds pristine writable sandboxes and
# uses XFS reflink clones for cheap benchmark resets.
export WASP_GITLAB_TAR="/scratch0/$USER/wasp/images/gitlab-populated-final-port8023.tar"
export WASP_REDDIT_TAR="/scratch0/$USER/wasp/images/postmill-populated-exposed-withimg.tar"
export WASP_GITLAB_SANDBOX="/scratch0/$USER/wasp/singularity/gitlab-pristine"
export WASP_REDDIT_SANDBOX="/scratch0/$USER/wasp/singularity/reddit-pristine"

# Optional: WASP's intermediate-action classifier is separate from its native
# final-state oracles. Set this plus OPENAI_API_KEY (or Azure equivalents) only
# if that secondary score is required.
export WASP_INTERMEDIATE_CLASSIFIER_MODEL=""
