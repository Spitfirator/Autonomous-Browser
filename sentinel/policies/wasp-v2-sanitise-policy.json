{
  "policies": {
    "mode": "enforce",
    "domain_allowlist": null,
    "domain_blocklist": [],
    "blocked_actions": [],
    "approval_required_actions": [],
    "approval_required_domains": [],
    "sensitive_domains": [],
    "prompt_injection": {
      "enabled": true,
      "detection_threshold": 0.55,
      "block_threshold": 0.85,
      "browser_sanitize": true,
      "hard_block_sinks": [
        "search",
