      "enabled": true,
      "trusted_domains": [],
      "sensitive_data_verdict": "block"
    },
    "adaptive_approvals": {
      "enabled": true,
      "approval_risk_threshold": 70,
      "grant_ttl_s": 300,
      "grant_max_uses": 3,
      "max_prompts_per_run": 4,
      "fatigue_strategy": "block"
    },
    "audit": {
      "store_screenshots": false,
      "store_model_reasoning": false
    },
    "budgets": {
      "max_steps": 20,
      "max_llm_calls": 30,
      "approval_timeout_s": 1,
      "handover_timeout_s": 0.05
    }
  }
