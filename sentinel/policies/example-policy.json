{
  "policies": {
    "mode": "enforce",

    "domain_allowlist": null,

    "domain_blocklist": [
      "*.bank.com",
      "internal-admin.corp",
      "facebook"
    ],

    "blocked_actions": [
      "upload_file"
    ],

    "approval_required_actions": [
      "execute_javascript"
    ],
    "approval_required_domains": [
      "checkout.stripe.com",
      "*.paypal.com"
    ],

    "sensitive_domains": [
      "accounts.google.com",
      "*.okta.com"
    ],

    "prompt_injection": {
      "enabled": true,
      "detection_threshold": 0.55,
      "block_threshold": 0.85
    },

    "data_flow": {
      "enabled": true,
      "trusted_domains": ["accounts.example.com"],
      "sensitive_data_verdict": "block"
    },

    "adaptive_approvals": {
      "enabled": true,
      "approval_risk_threshold": 55,
      "grant_ttl_s": 300,
      "grant_max_uses": 3,
      "max_prompts_per_run": 4,
      "fatigue_strategy": "handoff"
    },

    "audit": {
      "store_screenshots": false,
      "store_model_reasoning": false
    },

    "budgets": {
      "max_steps": 30,
      "max_llm_calls": 60,
      "approval_timeout_s": 120,
      "handover_timeout_s": 900
    }
  }
}
