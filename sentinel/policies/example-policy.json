{
  "policies": {
    "mode": "enforce",

    "domain_allowlist": null,

    "domain_blocklist": [
      "*.bank.com",
      "internal-admin.corp",
      "facebook"
    ],

    "blocked_actions": [
      "upload_file"
    ],

    "approval_required_actions": [
      "execute_javascript"
    ],
